# ─────────────────────────────────────────────────────────────────────────────
# Gifts19 environment. Copy to .env for local development.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────

# demo = simulated gateway/provider/email, DEMO banner, TEST vouchers.
# live = real customers and money; refuses demo adapters and missing secrets.
# Required for any production build (Vercel included).
APP_MODE="demo"

# Postgres. DATABASE_URL may be a pooled URL; DIRECT_URL must be a direct
# (unpooled) connection — Prisma uses it for migrations.
# Local (pnpm db:start): both postgresql://postgres:postgres@localhost:5433/gifts19
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/gifts19"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/gifts19"

# Public origin for payment return URLs and email links. Required in live
# mode. Demo on Vercel falls back to https://$VERCEL_URL; locally localhost.
SITE_URL="http://localhost:3001"

# ── Secrets (required on every deployed build; local dev has fallbacks) ─────
# AES-256 key for voucher codes/PINs at rest: 64 hex chars (32 bytes).
# Losing or changing it makes stored vouchers unreadable.
VOUCHER_ENCRYPTION_KEY=""
# Shared secret that gateway webhooks / return redirects are signed with.
PAYMENT_WEBHOOK_SECRET=""
# Bearer token for /api/internal/cron/* (Vercel Cron sends it automatically).
CRON_SECRET=""

# ── Adapters ───────────────────────────────────────────────────────────────
PAYMENT_GATEWAY="demo"
GIFT_CARD_PROVIDER="DEMO"
EMAIL_PROVIDER="demo"   # demo | brevo
# Brevo (free tier; no domain needed — verify a single sender in Brevo).
# In demo mode a copy of every email still lands in /demo/emails.
# BREVO_API_KEY=""
# EMAIL_FROM="you@gmail.com"
# EMAIL_FROM_NAME="Gifts19"

# WhatsApp order updates via Meta WhatsApp Cloud API (off by default).
# Customers must add a number and opt in on their profile.
# WHATSAPP_PROVIDER="meta"
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_MESSAGE_MODE="template"   # template | text (text: only to people who messaged you in 24h)
# WHATSAPP_TEMPLATE_LANGUAGE="en"
# WHATSAPP_API_VERSION="v23.0"

# Optional convenience fee on top of the selling price, in basis points.
# CONVENIENCE_FEE_BPS="0"

# Rate limiting: trust X-Forwarded-For only behind your own proxy. On Vercel
# the platform's x-real-ip is used automatically.
# TRUST_PROXY_HEADERS="true"

# ── Demo accounts (pnpm db:seed, demo mode only) ──────────────────────────
DEMO_ADMIN_EMAIL="admin@gifts19.test"
DEMO_ADMIN_PASSWORD=""
# DEMO_CUSTOMER_EMAIL="customer@gifts19.test"
# DEMO_CUSTOMER_PASSWORD=""

# ── Company details shown on legal/trust pages (placeholders until set) ───
# COMPANY_LEGAL_NAME=""
# COMPANY_ADDRESS=""
# COMPANY_GSTIN=""
# COMPANY_CIN=""
# SUPPORT_EMAIL=""
# SUPPORT_HOURS=""
# GRIEVANCE_OFFICER=""
# GRIEVANCE_EMAIL=""

# LOG_LEVEL="info"   # debug | info | silent
