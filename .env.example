# SQLite database file, relative to prisma/schema.prisma.
# Swap for a hosted DB URL (Turso/Postgres) when deploying.
DATABASE_URL="file:./dev.db"

# Public origin, used for payment return URLs and email links.
# Leave unset locally to use whatever host you browse from.
# NEXT_PUBLIC_SITE_URL="https://gifts19.in"

# --- Secrets: REQUIRED in production (dev falls back to fake values) -------
# AES-256 key for voucher codes at rest. 64 hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing or changing it makes existing voucher codes unreadable.
VOUCHER_ENCRYPTION_KEY=""
# Secret the payment gateway signs return redirects and webhooks with.
PAYMENT_WEBHOOK_SECRET=""

# --- Payments ----------------------------------------------------------------
# Gateway adapter from lib/gateway: "mock" until a real one is added.
PAYMENT_GATEWAY="mock"
# The mock gateway issues vouchers for free, so production refuses it
# unless this is "true" (only for a staging deploy).
# ALLOW_MOCK_PAYMENTS="true"
